# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/dgre_db"
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dgre_db

# Hugging Face Token (for spatial/RAG features)
HF_TOKEN=""

# LLM Provider (colab, groq, openrouter, openai, ollama)
LLM_PROVIDER=colab

# OpenRouter API Configuration
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct:free"

# Groq API Configuration
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenAI API Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Ollama / Local Colab Tunnel Configuration
OLLAMA_COLAB_URL="https://deonna-veracious-belen.ngrok-free.dev"
OLLAMA_MODEL="CartaGen_LoRA_SQL_SIG"
COLAB_MODEL="CartaGen_LoRA_SQL_SIG"

# LLM Parameters
TEMPERATURE=0.1
MAX_TOKENS=1024

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=3600
