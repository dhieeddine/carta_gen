import pandas as pd
import numpy as np
import geopandas as gpd
import matplotlib.pyplot as plt
from matplotlib.colors import ListedColormap, BoundaryNorm
from matplotlib.patches import Patch
import psycopg2
import os

conn = psycopg2.connect(os.environ['DATABASE_URL'])
query = """[requete_sql]"""
df = pd.read_sql(query, conn)
conn.close()
df.columns = df.columns.str.lower()

# Chargement des couches géographiques depuis PostGIS
import sqlalchemy
engine = sqlalchemy.create_engine(os.environ['DATABASE_URL'])
gdf_pays = gpd.read_postgis('SELECT geom FROM limite_pays_polygon', engine, geom_col='geom').to_crs('EPSG:32632')
gdf_gouv = gpd.read_postgis('SELECT lib_fr, geom FROM gouvernorats', engine, geom_col='geom').to_crs('EPSG:32632')

gdf_stations = gpd.GeoDataFrame(df, geometry=gpd.points_from_xy(df['x'], df['y']), crs="EPSG:32632")
titre_carte = 'Reseau Pluviometrique — Implantation et Precipitations Annuelles (mm)'

niveaux = [0, 100, 200, 300, 500, 700, 1000, 1500]
labels  = ['<100 mm', '100-200', '200-300', '300-500', '500-700', '700-1000', '>1000 mm']
couleurs = ['#d73027', '#fc8d59', '#fee090', '#e0f3f8', '#91bfdb', '#4575b4', '#313695']
cmap = ListedColormap(couleurs)
norm = BoundaryNorm(niveaux, cmap.N)

fig, ax = plt.subplots(figsize=(9, 11))
ax.set_aspect('equal')

gdf_pays.plot(ax=ax, color='#f5f5f0', edgecolor='black', linewidth=1.5, zorder=1)
gdf_gouv.boundary.plot(ax=ax, color='grey', linestyle='--', linewidth=0.6, zorder=2)

sc = ax.scatter(df['x'], df['y'], c=df['total'], cmap=cmap, norm=norm, s=40, 
                edgecolor='black', linewidth=0.8, alpha=0.9, zorder=3, label='Stations')

cbar = plt.colorbar(sc, ax=ax, orientation='vertical', pad=0.03, shrink=0.75, extend='max')
cbar.set_label('Precipitations Annuelles Totales (mm)', fontsize=10, fontweight='bold')
cbar.ax.tick_params(labelsize=8)

bounds = gdf_pays.total_bounds
margin = 15000
ax.set_xlim(bounds[0] - margin, bounds[2] + margin)
ax.set_ylim(bounds[1] - margin, bounds[3] + margin)
ax.set_title(titre_carte, fontsize=13, fontweight='bold')
ax.grid(True, linestyle='--', alpha=0.3)
plt.tight_layout()
plt.savefig('output_isohyete.png', dpi=300, bbox_inches='tight')
plt.close()
