# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/dgre_db"
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dgre_db

# Hugging Face Token (for spatial/RAG features)
HF_TOKEN=""

# LLM Provider (groq, openrouter, openai, ollama)
LLM_PROVIDER=groq

# OpenRouter API Configuration
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# Groq API Configuration
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenAI API Configuration
OPENAI_API_KEY=""

# Ollama / Local Colab Tunnel Configuration
OLLAMA_COLAB_URL="http://localhost:11434"
OLLAMA_MODEL="VisCoder2-7B"

# LLM Parameters
TEMPERATURE=0.1
MAX_TOKENS=1024

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=3600
